# Required
SUB_LIST_UUID=your-UUID   # listmonk admin → Lists → UUID
# Required for /count endpoint
SUB_API_USER=api                                       # listmonk admin → Users → API user
SUB_API_TOKEN=your-api-token-here                      # token for that user

# Optional overrides
SUB_LISTMONK_URL=https://list.ssp.sh                  # listmonk base URL
SUB_FORM_URL=https://list.ssp.sh/subscription/form    # browser redirect target
PORT=8080                                              # set automatically by Railway
